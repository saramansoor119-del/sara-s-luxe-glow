# Environment Variables Configuration
# Copy this file to .env.local and fill in your values for local development

# API Configuration (optional - only needed if using external APIs)
# VITE_API_URL=https://api.example.com

# Optional: Add other environment variables here
# VITE_ANALYTICS_ID=
# VITE_CDN_URL=

# For Vercel Production Environment:
# 1. Go to Vercel Dashboard → Your Project → Settings → Environment Variables
# 2. Add variables there (do NOT add secrets in .env.example or code)
# 3. Example: VITE_API_URL = https://your-api-domain.com
